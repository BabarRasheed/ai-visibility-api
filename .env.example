# ============================================================
# AI Visibility Intelligence API — Environment Variables
# Copy this file to .env and fill in your actual values.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-me-in-production-use-a-long-random-string

# --- Database ---
# SQLite (default for development):
DATABASE_URL=sqlite:///dev.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_visibility

# --- AI Provider (at least one required) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (optional, not used by default)
# ANTHROPIC_API_KEY=sk-ant-...

# --- DataForSEO (optional — falls back to simulation if not set) ---
DATAFORSEO_LOGIN=your-dataforseo-email
DATAFORSEO_PASSWORD=your-dataforseo-password

# --- Pipeline Settings ---
MAX_QUERIES_PER_RUN=20
TOP_OPPORTUNITIES=3
